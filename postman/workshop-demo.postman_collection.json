  {
   "name": "02 · Canary",
   "description": "Reparto de tráfico 90/10 entre canary-service-v1 (1.0.0-stable) y canary-service-v2 (2.0.0-canary) por pesos de la HTTPRoute. Ejecuta 'Petición repetible' con el Collection Runner (20-50 iteraciones) y mira la consola: el script acumula contadores por versión. Validado en vivo: 20 peticiones → 17 stable / 3 canary. Nota: en este servicio /api/echo y /api/slow devuelven 404 (la imagen desplegada no los implementa); /api/error sí devuelve 500.",
   "item": [
    {
     "name": "Petición repetible (cuenta versiones en consola)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "https://{{gateway_host}}/canary",
       "protocol": "https",
       "host": [
        "canary-dev.{{base_domain}}"
       ],
       "path": [
        ""
       ]
      },
      "description": "Repite esta petición muchas veces (Runner) y observa en la consola el reparto ~90/10."
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json();",
         "pm.test('Código 200', () => pm.response.to.have.status(200));",
         "pm.test('Es el canary-service', () => pm.expect(j.servicio).to.eql('canary-service'));",
         "pm.test('Versión estable o canary', () => pm.expect(j.version).to.be.oneOf(['1.0.0-stable', '2.0.0-canary']));",
         "// Contadores acumulados entre ejecuciones (usar el Runner con N iteraciones)",
         "let v1 = parseInt(pm.collectionVariables.get('canary_v1_count') || '0');",
         "let v2 = parseInt(pm.collectionVariables.get('canary_v2_count') || '0');",
         "if (j.version === '1.0.0-stable') v1++; else v2++;",
         "pm.collectionVariables.set('canary_v1_count', String(v1));",
         "pm.collectionVariables.set('canary_v2_count', String(v2));",
         "const total = v1 + v2;",
         "console.log(`Canary → v1 (stable): ${v1} · v2 (canary): ${v2} · total: ${total} · % canary: ${(100*v2/total).toFixed(1)}%`);"
        ]
       }
      }
     ]
    },
    {
     "name": "Reiniciar contadores",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "url": {
       "raw": "https://{{gateway_host}}/canary/health",
       "protocol": "https",
       "host": [
        "canary-dev.{{base_domain}}"
       ],
       "path": [
        "health"
       ]
      },
      "description": "Pone a cero los contadores canary_v1_count / canary_v2_count (aprovecha una llamada inocua a /health)."
     },
     "response": [],
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('canary_v1_count', '0');",
         "pm.collectionVariables.set('canary_v2_count', '0');",
         "console.log('Contadores del canary reiniciados.');"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Código 200', () => pm.response.to.have.status(200));"
        ]
       }
      }
     ]
    }
   ]
