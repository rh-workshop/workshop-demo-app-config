 "info": {
  "_postman_id": "b7e2c1a0-9d4f-4f6a-8f21-workshopdemo1",
  "name": "Workshop Demo · OpenShift Connectivity Link",
  "description": "Colección para probar los servicios del workshop (demo, canary, blue-green, circuit breaker) expuestos vía Gateway API + Kuadrant en OpenShift. Cambiar de cluster = cambiar la variable base_domain del environment.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
